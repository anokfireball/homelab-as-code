{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchFileNames": [
        "flux/**"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchFileNames": [
        "flux/**"
      ],
      "matchPackageNames": [
        "renovate",
        "ghcr.io/renovatebot/charts/renovate",
        "kube-prometheus-stack"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "fireflyiii/core",
        "fireflyiii/data-importer"
      ],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": [
        "ghcr.io/analogj/scrutiny",
        "longhorn/csi-snapshotter"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "longhorn",
        "kubernetes/kubernetes",
        "containerd/containerd"
      ],
      "automerge": false,
      "separateMultipleMinor": true
    },
    {
      "matchPackageNames": [
        "external-dns"
      ],
      "automerge": false
    },
    {
      "description": "Do not digest-pin OCI Helm charts. Flux marks charts from `type: oci` HelmRepositories as docker-datasource deps, so docker:pinDigests tries to resolve a digest for a chart tag (none exists) and the pin-dependencies branch fails.",
      "matchManagers": [
        "flux"
      ],
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    }
  ],
  "ignoreTests": true,
  "platformAutomerge": true,
  "ansible": {
    "managerFilePatterns": [
      "/ansible/.+\\.ya?ml$/"
    ]
  },
  "ansible-galaxy": {
    "managerFilePatterns": [
      "/ansible/.+/requirements\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update cluster k8s version",
      "managerFilePatterns": [
        "/ansible/cluster/roles/k8s_cluster/vars/main.yaml/"
      ],
      "matchStrings": [
        "k8s_version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update cluster containerd version",
      "managerFilePatterns": [
        "/ansible/cluster/roles/k8s_cluster/vars/main.yaml/"
      ],
      "matchStrings": [
        "containerd_version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "containerd/containerd",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update cluster calico version",
      "managerFilePatterns": [
        "/ansible/cluster/roles/k8s_cluster/vars/main.yaml/"
      ],
      "matchStrings": [
        "calico_version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "projectcalico/calico",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update cluster kube-vip version",
      "managerFilePatterns": [
        "/ansible/cluster/roles/k8s_cluster/vars/main.yaml/"
      ],
      "matchStrings": [
        "kube_vip_version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "kube-vip/kube-vip",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update cluster flux version",
      "managerFilePatterns": [
        "/ansible/cluster/roles/k8s_flux/vars/main.yaml/"
      ],
      "matchStrings": [
        "flux_version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "fluxcd/flux2",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update CNPG postgres 15 images (operand catalog, prebackup, init containers)",
      "managerFilePatterns": [
        "/flux/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>15\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "cloudnative-pg/postgresql",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^(?<major>15)\\.(?<minor>\\d+)-standard-trixie$",
      "extractVersionTemplate": "^(?<version>15\\.\\d+-standard-trixie)$"
    },
    {
      "customType": "regex",
      "description": "Update CNPG postgres 16 images (prebackup, init containers)",
      "managerFilePatterns": [
        "/flux/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>16\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "cloudnative-pg/postgresql",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^(?<major>16)\\.(?<minor>\\d+)-standard-trixie$",
      "extractVersionTemplate": "^(?<version>16\\.\\d+-standard-trixie)$"
    },
    {
      "customType": "regex",
      "description": "Update CNPG postgres 17 images (operand catalog, prebackup, init containers)",
      "managerFilePatterns": [
        "/flux/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>17\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "cloudnative-pg/postgresql",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^(?<major>17)\\.(?<minor>\\d+)-standard-trixie$",
      "extractVersionTemplate": "^(?<version>17\\.\\d+-standard-trixie)$"
    },
    {
      "customType": "regex",
      "description": "Update CNPG postgres 18 images (operand catalog, prebackup, init containers)",
      "managerFilePatterns": [
        "/flux/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>18\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "cloudnative-pg/postgresql",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^(?<major>18)\\.(?<minor>\\d+)-standard-trixie$",
      "extractVersionTemplate": "^(?<version>18\\.\\d+-standard-trixie)$"
    },
    {
      "customType": "regex",
      "description": "Update Pinniped deployment container image",
      "managerFilePatterns": [
        "/flux/system/infrastructure-configs/pinniped-supervisor.yaml/",
        "/flux/system/infrastructure-configs/pinniped-concierge.yaml/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/vmware/pinniped/pinniped-server:(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "vmware/pinniped/pinniped-server",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update immich VectorChord CNPG catalog image",
      "managerFilePatterns": [
        "/flux/apps/vectorchord-catalog.yaml/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/tensorchord/cloudnative-vectorchord:(?<currentValue>\\d+\\.?\\d*-\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "tensorchord/cloudnative-vectorchord",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^16(?:\\.\\d+)?-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "image: ghcr.io/tensorchord/cloudnative-vectorchord:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update wger PowerSync service image tag",
      "managerFilePatterns": [
        "/flux/apps/wger.yaml/"
      ],
      "matchStrings": [
        "powersync:\\s*image:\\s*tag: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "journeyapps/powersync-service",
      "registryUrlTemplate": "https://index.docker.io",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update Unifi MongoDBCommunity version",
      "managerFilePatterns": [
        "/flux/apps/unifi.yaml/"
      ],
      "matchStrings": [
        "kind: MongoDBCommunity[\\s\\S]*?version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "mongodb/mongo",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^r(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update k8up CRDs",
      "managerFilePatterns": [
        "/flux/repositories/k8up-io.yaml/"
      ],
      "matchStrings": [
        "tag: k8up-(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k8up-io/k8up",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^k8up-(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update csi-snapshotter CRDs",
      "managerFilePatterns": [
        "/flux/repositories/csi-snapshotter.yaml/"
      ],
      "matchStrings": [
        "tag: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "longhorn/csi-snapshotter",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update kyverno healthcheck base image",
      "managerFilePatterns": [
        "/flux/system/app-configs/kyverno.yaml/"
      ],
      "matchStrings": [
        "image: ghcr\\.io/anokfireball/base-image:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "anokfireball/base-image",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update sops version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/ansible-pull/vars/main.yaml/"
      ],
      "matchStrings": [
        "sops_version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "getsops/sops",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update go version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/caddy/vars/main.yaml/"
      ],
      "matchStrings": [
        "go_version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "golang/go",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^go(?<version>\\d+\\.\\d+\\.\\d+)(rc\\d+)?$"
    },
    {
      "customType": "regex",
      "description": "Update caddy version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/caddy/vars/main.yaml/"
      ],
      "matchStrings": [
        "caddy_version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "caddyserver/caddy",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update caddy cloudflare plugin version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/caddy/vars/main.yaml/"
      ],
      "matchStrings": [
        "caddy_cloudflare_version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "caddy-dns/cloudflare",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update caddy netcup plugin version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/caddy/vars/main.yaml/"
      ],
      "matchStrings": [
        "caddy_netcup_version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "caddy-dns/netcup",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update caddy porkbun plugin version",
      "managerFilePatterns": [
        "/ansible/gateway/roles/caddy/vars/main.yaml/"
      ],
      "matchStrings": [
        "caddy_porkbun_version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "caddy-dns/porkbun",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track Pinniped version for manifest refresh",
      "managerFilePatterns": [
        "/flux/system/infrastructure-configs/pinniped-supervisor.yaml/",
        "/flux/system/infrastructure-configs/pinniped-concierge.yaml/"
      ],
      "matchStrings": [
        "# pinniped-version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "vmware-tanzu/pinniped",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/flux/clusters/.+gotk-components\\.ya?ml$/",
      "/flux/namespaces/.+\\.ya?ml$/",
      "/flux/repositories/.+\\.ya?ml$/",
      "/flux/system/.+\\.ya?ml$/",
      "/flux/apps/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/flux/.+kustomization\\.ya?ml$/"
    ]
  }
}