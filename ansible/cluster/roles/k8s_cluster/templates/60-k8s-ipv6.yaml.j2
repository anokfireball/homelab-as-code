network:
    ethernets:
        eth0:
            dhcp6: false
            accept-ra: true
            ra-overrides:
              use-dns: false
              use-domains: false
            # no explicit routes: the kernel adds the on-link /64 for this address, and RA provides the default
            # route. A static route via the gateway made networkd restarts fail ("Could not set route: No route
            # to host"), which takes all of eth0 down, IPv4 included
            addresses:
                - "{{ node_ula_prefix }}{{ node_suffix }}/64"
