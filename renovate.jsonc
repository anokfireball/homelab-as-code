{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  // No PR rate limits.
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,

  // Files the built-in managers read.
  "ansible": {
    "managerFilePatterns": ["/ansible/.+\\.ya?ml$/"]
  },
  "ansible-galaxy": {
    "managerFilePatterns": ["/ansible/.+/requirements\\.ya?ml$/"]
  },
  "flux": {
    "managerFilePatterns": [
      "/flux/clusters/.+gotk-components\\.ya?ml$/",
      "/flux/namespaces/.+\\.ya?ml$/",
      "/flux/repositories/.+\\.ya?ml$/",
      "/flux/system/.+\\.ya?ml$/",
      "/flux/apps/.+\\.ya?ml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": ["/flux/.+kustomization\\.ya?ml$/"]
  },

  // Every matching rule applies, top to bottom; a later rule overrides an
  // earlier one. Sections set different options, except that the "never
  // automerge" rules at the end override any automerge rule above them.
  "packageRules": [
    // ── Versioning ───────────────────────────────────────────────────────
    {
      "description": "Firefly III tags are prefixed with `version-`.",
      "matchPackageNames": ["fireflyiii/core", "fireflyiii/data-importer"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },

    // ── Envoy proxy image override ───────────────────────────────────────
    // The override must stay on the Envoy minor that gateway-helm ships, so
    // only its patches and digests update on their own.
    {
      "description": "Envoy proxy override: track distroless-vX.Y.Z tags.",
      "matchPackageNames": ["envoyproxy/envoy"],
      "versioning": "regex:^distroless-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      // Keeps patches coming while a newer minor exists but is blocked.
      "separateMinorPatch": true
    },
    {
      "description": "Envoy proxy override: no major or minor updates.",
      "matchPackageNames": ["envoyproxy/envoy"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "A gateway-helm minor or major bump changes the Envoy minor its controller expects, so the Envoy image override must move in the same PR.",
      "matchPackageNames": ["docker.io/envoyproxy/gateway-helm"],
      "matchUpdateTypes": ["major", "minor"],
      "prBodyNotes": ["⚠️ This release ships a different Envoy minor. In this PR, update the `image:` override on `EnvoyProxy eg-shared` in `flux/system/app-configs/envoy-gateway.yaml` to the new Envoy minor (at least the release's `DefaultEnvoyProxyImage`), or delete it. The `Envoy Proxy Compat` check fails until then."]
    },

    // ── Release notes ────────────────────────────────────────────────────
    {
      // OCI Helm charts on ghcr.io carry no source metadata Renovate can use.
      // Chart and app share the vX.Y.Z release.
      "description": "Point spegel PRs at the spegel repo for release notes.",
      "matchPackageNames": ["ghcr.io/spegel-org/spegel", "ghcr.io/spegel-org/helm-charts/spegel"],
      "sourceUrl": "https://github.com/spegel-org/spegel"
    },
    {
      // Chart releases live in renovatebot/helm-charts as renovate-<version>;
      // the chart metadata points at the app repo, which has no 46.x tags.
      "description": "Release notes for the renovate chart.",
      "matchPackageNames": ["ghcr.io/renovatebot/charts/renovate"],
      "sourceUrl": "https://github.com/renovatebot/helm-charts"
    },
    {
      // Chart releases carry a prefix that Renovate does not strip. The prefix
      // is optional, so index versions pass through extractVersion unchanged.
      "description": "Release notes for loki chart releases tagged helm-loki-<version>.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["loki"],
      "extractVersion": "^(?:helm-loki-)?(?<version>.+)$"
    },
    {
      "description": "Release notes for reloader chart releases tagged chart-v<version>.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["reloader"],
      "extractVersion": "^(?:chart-v)?(?<version>.+)$"
    },
    {
      "description": "Release notes for external-dns chart releases tagged external-dns-helm-chart-<version>.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["external-dns"],
      "extractVersion": "^(?:external-dns-helm-chart-)?(?<version>.+)$"
    },
    {
      // No source label on the image; kubernetes/autoscaler tags VPA releases
      // vertical-pod-autoscaler-<version>.
      "description": "Release notes for vpa-recommender.",
      "matchPackageNames": ["registry.k8s.io/autoscaling/vpa-recommender"],
      "sourceUrl": "https://github.com/kubernetes/autoscaler",
      "extractVersion": "^(?:vertical-pod-autoscaler-)?(?<version>.+)$"
    },
    {
      // The image label points at linuxserver/docker-qbittorrent, whose tags
      // carry -lsN suffixes; upstream tags releases release-<version>.
      "description": "Release notes for the LinuxServer qBittorrent image.",
      "matchPackageNames": ["ghcr.io/linuxserver/qbittorrent"],
      "sourceUrl": "https://github.com/qbittorrent/qBittorrent",
      "extractVersion": "^(?:release-)?(?<version>.+)$"
    },
    {
      // These images have no usable source label; upstream releases are
      // tagged exactly like the image (vX.Y.Z or X.Y.Z → vX.Y.Z).
      "description": "Release notes for cert-manager images.",
      "matchPackageNames": [
        "quay.io/jetstack/cert-manager-controller",
        "quay.io/jetstack/cert-manager-webhook",
        "quay.io/jetstack/cert-manager-cainjector",
        "quay.io/jetstack/cert-manager-acmesolver",
        "quay.io/jetstack/cert-manager-startupapicheck"
      ],
      "sourceUrl": "https://github.com/cert-manager/cert-manager"
    },
    {
      "description": "Release notes for the Envoy Gateway image.",
      "matchPackageNames": ["docker.io/envoyproxy/gateway"],
      "sourceUrl": "https://github.com/envoyproxy/gateway"
    },
    {
      "description": "Release notes for the Loki and loki-canary images.",
      "matchPackageNames": ["docker.io/grafana/loki", "docker.io/grafana/loki-canary"],
      "sourceUrl": "https://github.com/grafana/loki"
    },
    {
      "description": "Release notes for memcached-exporter.",
      "matchPackageNames": ["prom/memcached-exporter"],
      "sourceUrl": "https://github.com/prometheus/memcached_exporter"
    },
    {
      // The deb datasource has no source URL.
      "description": "Release notes for containerd.io.",
      "matchPackageNames": ["containerd.io"],
      "sourceUrl": "https://github.com/containerd/containerd"
    },
    {
      // The image label points at influxdata/influxdata-docker, which has no releases.
      "description": "Release notes for influxdb.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["influxdb"],
      "sourceUrl": "https://github.com/influxdata/influxdb"
    },
    // Link only: these versions can never equal an upstream release tag.
    {
      // Chart versions are git tags kyverno-chart-<version> without GitHub Releases.
      "description": "Changelog link for the kyverno chart.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["kyverno"],
      "changelogUrl": "https://github.com/kyverno/kyverno/compare/kyverno-chart-{{{currentVersion}}}...kyverno-chart-{{{newVersion}}}"
    },
    {
      // distroless-vX.Y.Z image tags; upstream releases are vX.Y.Z.
      "description": "Changelog link for the Envoy proxy image.",
      "matchPackageNames": ["envoyproxy/envoy"],
      "sourceUrl": "https://github.com/envoyproxy/envoy",
      "changelogUrl": "https://github.com/envoyproxy/envoy/releases/tag/{{{replace 'distroless-' '' newVersion}}}"
    },
    {
      // version-X.Y.Z image tags; upstream releases are vX.Y.Z.
      "description": "Changelog link for the Firefly III image.",
      "matchPackageNames": ["fireflyiii/core"],
      "sourceUrl": "https://github.com/firefly-iii/firefly-iii",
      "changelogUrl": "https://github.com/firefly-iii/firefly-iii/releases/tag/{{{replace 'version-' 'v' newVersion}}}"
    },
    {
      "description": "Changelog link for the Firefly III data importer image.",
      "matchPackageNames": ["fireflyiii/data-importer"],
      "sourceUrl": "https://github.com/firefly-iii/data-importer",
      "changelogUrl": "https://github.com/firefly-iii/data-importer/releases/tag/{{{replace 'version-' 'v' newVersion}}}"
    },

    // ── Pinning and grouping ─────────────────────────────────────────────
    {
      // The flux manager reports charts from `type: oci` HelmRepositories as
      // docker deps, and a chart tag has no digest to pin. Images in
      // HelmRelease values are covered too: no new pins, but existing
      // digests still update.
      "description": "No new digest pins on docker deps found by the flux manager.",
      "matchManagers": ["flux"],
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Group the n8n main image and task-runner sidecar so they update together.",
      "matchPackageNames": ["ghcr.io/n8n-io/n8n", "n8nio/runners"],
      "groupName": "n8n"
    },
    {
      "description": "One PR per minor release, for components that upgrade one minor at a time.",
      "matchPackageNames": [
        "kubernetes/kubernetes",
        "containerd.io",
        "longhorn",
        "docker.io/longhornio/longhorn-ui",
        "longhornio/longhorn-manager"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "Group the Longhorn chart with the UI, manager and CSI sidecar images pinned at its appVersion.",
      "matchPackageNames": [
        "longhorn",
        "docker.io/longhornio/longhorn-ui",
        "longhornio/longhorn-manager",
        "docker.io/longhornio/csi-attacher",
        "docker.io/longhornio/csi-provisioner",
        "docker.io/longhornio/csi-resizer",
        "docker.io/longhornio/csi-snapshotter"
      ],
      "groupName": "longhorn"
    },
    {
      "description": "Group the MetalLB chart with the controller and speaker images pinned at its appVersion.",
      "matchPackageNames": [
        "metallb",
        "quay.io/metallb/controller",
        "quay.io/metallb/speaker"
      ],
      "groupName": "metallb"
    },
    {
      "description": "Group the MongoDB operator chart with the operator image pinned at its appVersion.",
      "matchPackageNames": [
        "mongodb-kubernetes",
        "quay.io/mongodb/mongodb-kubernetes-operator"
      ],
      "groupName": "mongodb-kubernetes"
    },
    {
      "description": "Group kube-prometheus-stack with the operator and config-reloader images pinned at its appVersion.",
      "matchPackageNames": [
        "kube-prometheus-stack",
        "quay.io/prometheus-operator/prometheus-operator",
        "quay.io/prometheus-operator/prometheus-config-reloader"
      ],
      "groupName": "kube-prometheus-stack"
    },

    // ── Automerge ────────────────────────────────────────────────────────
    // Renovate turns on GitHub auto-merge (platformAutomerge, on by default);
    // GitHub merges once the required "CI - Success" check passes.
    {
      "description": "Automerge patch and digest updates under flux/.",
      "matchFileNames": ["flux/**"],
      "matchUpdateTypes": ["patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge minor, patch and digest updates for low-risk packages.",
      "matchPackageNames": [
        // Renovate. A validator image bump is tested by the CI job it updates.
        "ghcr.io/renovatebot/charts/renovate",
        "ghcr.io/renovatebot/renovate",
        // n8n
        "oci.trueforge.org/truecharts/n8n",
        "ghcr.io/n8n-io/n8n",
        "n8nio/runners",
        // Monitoring and logging
        "kube-prometheus-stack",
        "quay.io/prometheus-operator/prometheus-operator",
        "quay.io/prometheus-operator/prometheus-config-reloader",
        "docker.io/grafana/grafana",
        "docker.io/kiwigrid/k8s-sidecar",
        "quay.io/kiwigrid/k8s-sidecar",
        "loki",
        "docker.io/grafana/loki",
        "docker.io/grafana/loki-canary",
        "docker.io/nginxinc/nginx-unprivileged",
        "prom/memcached-exporter",
        "ghcr.io/starosdev/scrutiny",
        "goldilocks",
        "us-docker.pkg.dev/fairwinds-ops/oss/goldilocks",
        // Apps
        "ghcr.io/gethomepage/homepage",
        "jellyfin",
        "stirling-pdf-chart",
        "ghcr.io/stirling-tools/stirling-pdf",
        "docker.io/journeyapps/powersync-service"
      ],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge Go and Caddy patch releases; minors and majors stay manual.",
      "matchPackageNames": ["golang/go", "caddyserver/caddy"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },

    // ── Never automerge (keep last) ──────────────────────────────────────
    {
      "description": "Never automerge 0.x versions.",
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Never automerge these packages.",
      "matchPackageNames": [
        // Cluster runtime and networking
        "kubernetes/kubernetes",
        "containerd.io",
        "external-dns",
        // Storage
        "longhorn",
        "longhorn/csi-snapshotter",
        "docker.io/longhornio/longhorn-ui",
        "longhornio/longhorn-manager",
        "docker.io/longhornio/csi-attacher",
        "docker.io/longhornio/csi-provisioner",
        "docker.io/longhornio/csi-resizer",
        "docker.io/longhornio/csi-snapshotter",
        // One chart version renders many HelmReleases at once.
        "app-template",
        // The data plane runs a single replica, so each merge restarts it.
        "envoyproxy/envoy"
      ],
      "automerge": false
    }
  ],

  // Versions the built-in managers cannot see.
  "customManagers": [
    // ── Ansible ──────────────────────────────────────────────────────────
    {
      "customType": "regex",
      // Annotation fields, in this order: datasource, depName, then optionally
      // registryUrl and extractVersion. The variable follows on the next line;
      // its value is the version as written, `v` prefix included, and is
      // compared as semver.
      "description": "Ansible variables annotated with a `# renovate:` comment.",
      "managerFilePatterns": ["/ansible/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s*[\\w-]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "semver"
    },

    // ── Flux: images the flux manager does not read ──────────────────────
    {
      "customType": "regex",
      // pgMajor pins lookups to the major already in the file; a major
      // upgrade of a CNPG cluster is a migration, not a tag bump.
      // The second pattern is the immich PreBackupPod image pinned in a
      // kyverno-exceptions ImageValidatingPolicy exception.
      "description": "CNPG PostgreSQL images (image catalogs, backup and init containers, Kyverno exceptions).",
      "managerFilePatterns": ["/flux/.+\\.ya?ml$/"],
      "matchStrings": [
        "image: ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>(?<pgMajor>\\d+)\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)",
        "c\\.image == 'ghcr\\.io/cloudnative-pg/postgresql:(?<currentValue>(?<pgMajor>\\d+)\\.\\d+-standard-trixie)@(?<currentDigest>sha256:[a-f0-9]+)'"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/cloudnative-pg/postgresql",
      "versioningTemplate": "regex:^(?<major>{{{pgMajor}}})\\.(?<minor>\\d+)-standard-trixie$",
      "extractVersionTemplate": "^(?<version>{{{pgMajor}}}\\.\\d+-standard-trixie)$"
    },
    {
      "customType": "regex",
      "description": "VectorChord image in the immich CNPG image catalog.",
      "managerFilePatterns": ["/flux/apps/vectorchord-catalog.yaml/"],
      "matchStrings": ["image: ghcr\\.io/tensorchord/cloudnative-vectorchord:(?<currentValue>\\d+\\.?\\d*-\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "tensorchord/cloudnative-vectorchord",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "regex:^16(?:\\.\\d+)?-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "autoReplaceStringTemplate": "image: ghcr.io/tensorchord/cloudnative-vectorchord:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      // Covers plain manifests, the Kyverno healthcheck policy and the
      // healthcheck annotations. Bumping an annotation forces a Helm re-apply,
      // so the mutated healthcheck re-rolls.
      "description": "anokfireball/base-image pins outside HelmRelease image values.",
      "managerFilePatterns": ["/flux/.+\\.ya?ml$/"],
      "matchStrings": [
        "image: ghcr\\.io/anokfireball/base-image:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)",
        "healthcheckImage: ghcr\\.io/anokfireball/base-image:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "ghcr.io/anokfireball/base-image",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      // The flux manager does not read images inside custom resource specs. The
      // digest group is optional so docker:pinDigests can add the pin and keep
      // refreshing it.
      "description": "Envoy proxy image pinned on EnvoyProxy eg-shared.",
      "managerFilePatterns": ["/flux/system/app-configs/envoy-gateway.yaml/"],
      "matchStrings": ["image: docker\\.io/envoyproxy/envoy:(?<currentValue>distroless-v\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "depNameTemplate": "envoyproxy/envoy",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "MongoDB version of the UniFi MongoDBCommunity resource.",
      "managerFilePatterns": ["/flux/apps/unifi.yaml/"],
      "matchStrings": ["kind: MongoDBCommunity[\\s\\S]*?version: \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "mongodb/mongo",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^r(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      // Annotation fields as in the Ansible manager: datasource, then depName.
      // The pin follows on the next line: `<key>: <version>@sha256:…` for Helm
      // values the flux manager cannot resolve, `image: <ref>:<version>@…` in
      // post-renderer patch strings. Above a Prometheus or Alertmanager CR
      // `version:`, the digest is on the next image.tag; Renovate rewrites the
      // version on both lines.
      "description": "Flux image pins annotated with a `# renovate:` comment.",
      "managerFilePatterns": ["/flux/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[\\w-]+: \"?(?<currentValue>[^\"\\s@:]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*image: \"?[^\"\\s@]+:(?<currentValue>[^\"\\s@:]+)@(?<currentDigest>sha256:[a-f0-9]+)\"?",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*version: (?<currentValue>\\S+)\\n\\s*image:\\n\\s*tag: [^\\s@]+@(?<currentDigest>sha256:[a-f0-9]+)"
      ]
    },

    // ── Flux: vendored manifests and CRD sources ─────────────────────────
    {
      "customType": "regex",
      "description": "Pinniped server image in the vendored Pinniped manifests.",
      "managerFilePatterns": [
        "/flux/system/infrastructure-configs/pinniped-supervisor.yaml/",
        "/flux/system/infrastructure-configs/pinniped-concierge.yaml/"
      ],
      "matchStrings": ["image: ghcr\\.io/vmware/pinniped/pinniped-server:(?<currentValue>v\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "vmware/pinniped/pinniped-server",
      "registryUrlTemplate": "https://ghcr.io",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Pinniped release of the vendored manifests (`# pinniped-version:` header).",
      "managerFilePatterns": [
        "/flux/system/infrastructure-configs/pinniped-supervisor.yaml/",
        "/flux/system/infrastructure-configs/pinniped-concierge.yaml/"
      ],
      "matchStrings": ["# pinniped-version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "vmware-tanzu/pinniped",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "k8up release the CRDs come from.",
      "managerFilePatterns": ["/flux/repositories/k8up-io.yaml/"],
      "matchStrings": ["tag: k8up-(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "k8up-io/k8up",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^k8up-(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      // depName matches the flux manager's GitRepository dep, so both land in
      // one PR.
      "description": "csi-snapshotter release the CRDs come from.",
      "managerFilePatterns": ["/flux/repositories/csi-snapshotter.yaml/"],
      "matchStrings": ["tag: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "longhorn/csi-snapshotter",
      "depNameTemplate": "csi-snapshotter",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)$"
    },

    // ── GitHub workflows ─────────────────────────────────────────────────
    {
      "customType": "regex",
      "description": "Go tools installed with `go install` in workflows.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["go install (?<depName>github\\.com/[^/\\s]+/[^/\\s]+)(?:/[^@\\s]+)*@(?<currentValue>v[^\\s\"']+)"],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      // The digest group is optional so docker:pinDigests can add the pin and
      // keep refreshing it.
      "description": "shellcheck image used by workflow lint.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["koalaman/shellcheck:(?<currentValue>v[\\d.]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "docker"
    }
  ]
}
